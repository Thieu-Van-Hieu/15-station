        "at": "d5-t1",
        "lines": [
          {
            "speaker": "tram-truong-doi",
            "text": "Giấy khoán thì cứ đối chiếu đúng sổ. Tôi đứng đây xem."
          }
        ]
      }
    ],
    "family_event": {
      "text": "Bé Bình bị sốt cao li bì từ đêm qua, bác sĩ bảo phải mua thuốc kháng sinh ngoài hiệu thuốc tư nhân thị xã."
    },
