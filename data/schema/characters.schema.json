{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "characters.schema.json",
  "title": "characters.json",
  "description": "Nhân vật. fixed_fields là dữ liệu phải giống nhau trên giấy tờ ở mọi lần xuất hiện. Đặc tả: docs/03-rules-spec.md mục 1.1.",
  "type": "array",
  "minItems": 1,
  "items": {
    "$ref": "#/$defs/character"
  },
  "$defs": {
    "characterId": {
      "anyOf": [
        {
          "enum": [
            "ba-tu",
            "anh-hung",
            "ong-quynh",
            "thang-ti",
            "chi-thu",
            "tram-truong-doi",
            "thanh",
            "hoa",
            "be-mai",
            "be-binh",
            "me-thanh"
          ]
        },
        {
          "type": "string",
          "pattern": "^np-[a-z0-9]+(-[a-z0-9]+)*$"
        }
      ]
    },
    "travelerId": {
      "type": "string",
      "pattern": "^d[1-6]-t[1-5]$"
    },
    "expression": {
      "enum": [
        "binh-thuong",
        "vui",
        "lo-lang",
        "buon",
        "gian",
        "ne-tranh",
        "met-moi"
      ]
    },
    "character": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "role",
        "age",
        "home",
        "background",
        "voice",
        "portrait",
        "fixed_fields",
        "appearances"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/characterId"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "nguoi-choi",
            "chinh",
            "phu",
            "gia-dinh",
            "mot-lan"
          ]
        },
        "age": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 110,
          "description": "Tuổi ở lần xuất hiện đầu tiên."
        },
        "home": {
          "type": "string",
          "minLength": 1
        },
        "background": {
          "type": "string",
          "minLength": 1
        },
        "voice": {
          "type": "string",
          "minLength": 1
        },
        "portrait": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "key",
            "expressions",
            "description"
          ],
          "properties": {
            "key": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            },
            "expressions": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/expression"
              }
            },
            "description": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "fixed_fields": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ho_ten",
                "nam_sinh"
              ],
              "properties": {
                "ho_ten": {
                  "type": "string",
                  "minLength": 2
                },
                "nam_sinh": {
                  "type": "integer",
                  "minimum": 1890,
                  "maximum": 1987
                },
                "noi_o": {
                  "type": "string",
                  "minLength": 1
                },
                "so_shk": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        },
        "appearances": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/travelerId"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "role": {
                "const": "chinh"
              }
            },
            "required": [
              "role"
            ]
          },
          "then": {
            "properties": {
              "appearances": {
                "minItems": 3,
                "type": "array"
              },
              "fixed_fields": {
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "mot-lan"
              }
            },
            "required": [
              "role"
            ]
          },
          "then": {
            "properties": {
              "appearances": {
                "minItems": 1,
                "maxItems": 1,
                "type": "array"
              },
              "id": {
                "type": "string",
                "pattern": "^np-"
              }
            }
          }
        }
      ]
    }
  }
}
